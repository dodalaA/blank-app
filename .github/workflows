name: Toss Automated Quant Engine

on:
  schedule:
    # 월~금 (UTC 00:00 ~ 06:30 -> KST 09:00 ~ 15:30) 매 30분마다 자동 실행
    - cron: '0,30 0-6 * * 1-5'
  workflow_dispatch: # 깃허브 웹 화면에서 수동 즉시 실행 지원

jobs:
  trade:
    runs-on: ubuntu-latest

    steps:
      - name: 저장소 체크아웃
        uses: actions/checkout@v3

      - name: 파이썬 3.10 환경 구성
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: 종속 라이브러리 설치
        run: |
          python -m pip install --upgrade pip
          pip install requests pandas numpy yfinance pytz

      - name: 토스 퀀트 트레이딩 스크립트 실행
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          TOSS_COOKIE: ${{ secrets.TOSS_COOKIE }}
          TOSS_XSRF: ${{ secrets.TOSS_XSRF }}
        run: |
          python toss_trader.py
